{
  "experimentalServices": {
    "frontend": {
      "entrypoint": ".",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/server.py",
      "routePrefix": "/backend"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": "/backend/api$1"
    }
  ]
}
